# 百度网盘 Web 界面反代(hub 网盘 tab,解决混合内容 + IP 硬编码)
# SPA 前端硬编码根绝对路径(/assets/ /api/ /favicon 等),需逐一反代到 10780
location /pan/ {
    proxy_pass http://127.0.0.1:10780/;
    proxy_set_header Host 127.0.0.1:10780;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
}
location /assets/ {
    proxy_pass http://127.0.0.1:10780/assets/;
    proxy_set_header Host 127.0.0.1:10780;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
}
location /api/ {
    proxy_pass http://127.0.0.1:10780/api/;
    proxy_set_header Host 127.0.0.1:10780;
    proxy_http_version 1.1;
    proxy_read_timeout 60s;
}
location = /favicon {
    proxy_pass http://127.0.0.1:10780/favicon;
}
location = /baidu-drive.png {
    proxy_pass http://127.0.0.1:10780/baidu-drive.png;
}
