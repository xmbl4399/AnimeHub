# 弹弹play API 反代(弹幕源,浏览器 CORS + fake-ip 绕法)
# 认证:X-AppId / X-AppSecret(DevCenter「影视库弹幕」vnzdneujkj)
# comment 接口会 302 到 cas2.dandanplay.net 的签名 URL(无 CORS 头,浏览器跨域跟随会被拦)。
# 方案:proxy_redirect 把 302 的 Location 改写成本地 /dandan-cas2/,浏览器同源跟随,
#       再由 /dandan-cas2/ 反代 cas2 返回弹幕。
# ⚠️ 全部用变量 proxy_pass + nginx resolver 直连公网 DNS:静态域名会在 nginx 启动时解析,
#   OpenClash fake-ip 下解析失败会 [emerg] host not found → nginx 起不来(2026-08-08 事故)
location /dandan/ {
    resolver 114.114.114.114 valid=300s ipv6=off;
    set $dd_api 'api.dandanplay.net';
    rewrite ^/dandan/(.*)$ /$1 break;
    proxy_pass https://$dd_api;
    proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";
    proxy_set_header X-AppId "vnzdneujkj";
    proxy_set_header X-AppSecret "w2kTPQEwqqqFLspte5Z38WWJsUabm5DA";
    proxy_ssl_server_name on;
    proxy_read_timeout 30s;
}

location ~ ^/dandan/api/v2/comment/(.*)$ {
    resolver 114.114.114.114 valid=300s ipv6=off;
    set $dd_api 'api.dandanplay.net';
    proxy_pass https://$dd_api/api/v2/comment/$1$is_args$args;
    proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";
    proxy_set_header X-AppId "vnzdneujkj";
    proxy_set_header X-AppSecret "w2kTPQEwqqqFLspte5Z38WWJsUabm5DA";
    proxy_ssl_server_name on;
    proxy_read_timeout 30s;
    proxy_redirect https://cas2.dandanplay.net/ /dandan-cas2/;
}

# 弹幕签名 URL(cas2)反代:浏览器跟随 /dandan-cas2/ 后同源拿到弹幕 JSON
location /dandan-cas2/ {
    resolver 114.114.114.114 valid=300s ipv6=off;
    set $dd_cas2 'cas2.dandanplay.net';
    rewrite ^/dandan-cas2/(.*)$ /$1 break;
    proxy_pass https://$dd_cas2;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36";
    proxy_ssl_server_name on;
    proxy_read_timeout 30s;
}
