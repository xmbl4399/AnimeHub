location /media/ {
    alias /mnt/mmcblk0p7/;
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;
    client_max_body_size 0;
    # 视频流 no-cache:配合 ETag 304 验证,避免大文件被浏览器长期缓存占用磁盘
    add_header Cache-Control "no-cache";
}

location /media-json/ {
    alias /mnt/mmcblk0p7/;
    autoindex on;
    autoindex_format json;
}
